root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing double space is a line break in Markdown
trim_trailing_whitespace = false

[*.{rs,toml}]
# Matches rustfmt and the Cargo conventions.
indent_size = 4
